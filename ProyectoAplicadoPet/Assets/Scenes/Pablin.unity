  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 183
  indentLevel: 0
  storyText: "Mira, no tienes que cont\xE1rmelo si no quieres, pero no me mientas.
    Ya sabes que odio las mentiras\u2026\r"
