  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 185
  indentLevel: 0
  storyText: "Lo entiendo, pero recuerda que siempre estoy aqu\xED, cuando quieras
    hablar, me dices.\r"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
