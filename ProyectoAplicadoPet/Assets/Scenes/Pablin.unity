  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 186
  indentLevel: 0
  storyText: "[No has hablado de tus preocupaciones, pero Morita te ha dejado claro
    que te apoya. Saber que no est\xE1s sola ha hecho que la tristeza disminuya un
    poco.]"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
